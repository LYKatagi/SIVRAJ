### `.gitattributes`

:::writing{variant="document" id="21694"}
# Normalize line endings
* text=auto

# Source code
*.py text eol=lf
*.pyw text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf

# Configuration
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.ini text eol=lf

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.wav binary
*.mp3 binary
*.mp4 binary
*.exe binary
*.dll binary
*.zip binary
```
